# ===================================================
# AMS — Smart Attendance Management System
# Environment Configuration Template
# ===================================================

# Database Connections (Neon PostgreSQL / Local PostgreSQL)
# For Neon in production:
# DATABASE_URL: Pooled connection string (e.g., postgres://user:pass@ep-xyz-pooler.region.neon.tech/ams_db?sslmode=require)
# DIRECT_URL: Direct unpooled connection string for migrations (e.g., postgres://user:pass@ep-xyz.region.neon.tech/ams_db?sslmode=require)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ams_db"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ams_db"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk Authentication (Optional for local dev, mandatory for production Clerk auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Application Settings
NEXT_PUBLIC_DEFAULT_ATTENDANCE_THRESHOLD="75"
