# ===================================================
# AMS — Smart Attendance Management System
# Production Environment Configuration Template
# ===================================================

# Neon PostgreSQL Database Connections
DATABASE_URL="YOUR_NEON_POOLED_CONNECTION_STRING"
DIRECT_URL="YOUR_NEON_DIRECT_CONNECTION_STRING"

# Auth.js Authentication Configuration
AUTH_SECRET="GENERATE_A_UNIQUE_PRODUCTION_SECRET"
AUTH_URL="YOUR_PRODUCTION_APPLICATION_URL"

# Google Cloud OAuth 2.0 Credentials (for Student Sign-In)
# Obtain from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.com/api/auth/callback/google
AUTH_GOOGLE_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
AUTH_GOOGLE_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"

# Dedicated Administrator Credentials (/bosshere Control Center)
ADMIN_USERNAME="YOUR_PRODUCTION_ADMIN_USERNAME"
ADMIN_PASSWORD="SET_A_STRONG_PRODUCTION_PASSWORD"
ADMIN_EMAIL="YOUR_ADMIN_EMAIL"

# Institutional Application Settings
NEXT_PUBLIC_DEFAULT_ATTENDANCE_THRESHOLD="75"
